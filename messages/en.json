{
  "About": {
    "title": "About",
    "eyebrow": "About Nhazi",
    "heading": "Renting should be simple for both sides of the key.",
    "lead": "Nhazi is a platform for landlords and property managers who rent out apartments, houses and offices, and for the tenants who live in them. It replaces scattered spreadsheets, chat threads and paper notes with one clear record.",
    "audiences": [
      {
        "title": "For owners and managers",
        "body": "Set up each property, its units, services and meters. Create leases and agreements, record readings, close billing periods and issue invoices. Invite your team and give each person the access they need."
      },
      {
        "title": "For tenants",
        "body": "Get invited by phone number and see your own lease, invoices and due dates in a dashboard of your own. Report a payment or send a repair request in a few taps."
      }
    ],
    "principlesTitle": "What we care about",
    "principles": [
      {
        "title": "Clear to everyone",
        "body": "Owners and tenants look at the same lease and the same invoice. No surprises, no guessing what a number means."
      },
      {
        "title": "Every figure has a source",
        "body": "Rent, meter readings and tiered utility prices are recorded, so any amount on an invoice traces back to the usage behind it."
      },
      {
        "title": "Built for local rentals",
        "body": "Amounts are in Vietnamese đồng (₫), with cash and bank-transfer payments, shared services and metered utilities handled the way rentals really work."
      },
      {
        "title": "You stay in control",
        "body": "Owners decide what is billed and when. Nhazi records invoices and reported payments. It never moves money on your behalf."
      }
    ],
    "ctaTitle": "Try it with your first property."
  },
